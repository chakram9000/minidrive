<!DOCTYPE html>
<html lang="en">
<head>
    <title>Share folder - Minidrive</title>
		<%- include("components/meta.ejs") %>
</head>
<body>
		<header class="header">
			<a class="header-brand" href="/drive">
				<span class="material-icons">cloud_queue</span>
				<span>Minidrive</span>
			</a>
			<div class="header-spacer"></div>
			<div class="header-nav">
				<span class="header-user"><%= user.username %></span>
				<a class="btn-text" href="/logout">Log out</a>
			</div>
		</header>

		<main class="main-content">
			<div class="card share-card">
				<a class="breadcrumb-back" href="/drive/folders/<%= dir.parentDirId %>">
					<span class="material-icons">arrow_back</span>
					Back
				</a>
				<h1 class="page-title">
					<span class="material-icons">share</span>
					Share '<%= dir.name %>'
				</h1>
				<p class="share-desc">
					Share this folder with others. <b>Anyone</b> with the link will have <i>read-only</i> access to it.
				</p>
				<form action="/drive/share/<%= dir.id %>" method="post">
					<div class="form-group">
						<label for="expires_at">Expires on</label>
						<input type="date" name="expires_at" id="expires_at" min="<%= new Date().toISOString().split('T')[0] %>" required>
					</div>
					<button class="btn btn-primary form-submit" type="submit">
						<span class="material-icons">link</span>
						Create share link
					</button>
				</form>
			</div>
		</main>
</body>
</html>
