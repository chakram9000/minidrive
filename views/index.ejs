<!DOCTYPE html>
<html lang="en">
<head>
    <title>Minidrive</title>
		<%- include("components/meta.ejs") %>
</head>
<body>
		<header class="header">
			<a class="header-brand" href="/">
				<span class="material-icons">cloud_queue</span>
				<span>Minidrive</span>
			</a>
			<div class="header-spacer"></div>
			<div class="header-nav">
				<% if (locals.user) { %>
					<span class="header-user"><%= user.username %></span>
					<a class="btn-text" href="/logout">Log out</a>
				<% } else { %>
					<a href="/login">Log in</a>
				<% } %>
			</div>
		</header>

		<main class="main-content">
			<div class="hero">
				<span class="material-icons hero-icon">cloud_queue</span>
				<h1>minidrive</h1>
				<% if (locals.user) { %>
					<p>Hi <strong><%= user.username %></strong>, welcome back.</p>
					<a class="btn btn-primary" style="display:inline-flex;" href="/drive">
						<span class="material-icons">folder_open</span>
						Open My Drive
					</a>
				<% } else { %>
					<p>Your own little slice of the cloud. Simple file storage, no clutter.</p>
					<div style="display:flex;gap:12px;justify-content:center;">
						<a class="btn btn-primary" style="display:inline-flex;" href="/login">
							<span class="material-icons">login</span>
							Log in
						</a>
						<a class="btn btn-outline" style="display:inline-flex;" href="/signup">Create account</a>
					</div>
				<% } %>
			</div>
		</main>
</body>
</html>
