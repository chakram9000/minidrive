// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          Int         @id @default(autoincrement())
  username    String      @unique @db.VarChar(64)
  password    String
  rootDirId   Int         @unique @map("root_dir_id")
  files       File[]
  directories Directory[]
}

model Directory {
  id          Int         @id @default(autoincrement())
  name        String
  files       File[]
  subDirs     Directory[] @relation("dir")
  parentDir   Directory?  @relation("dir", fields: [parentDirId], references: [id], onDelete: Cascade)
  parentDirId Int?
  owner       User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId     Int

  @@index([parentDirId]) // needed mainly for querying all nested dirs and files, but also helps in most operations.
}

model File {
  uuid        String    @unique @db.Uuid // no default, we set this to the uploaded file's generated uuid
  name        String
  size        Int // Bytes 
  parentDir   Directory @relation(fields: [parentDirId], references: [id], onDelete: Cascade)
  parentDirId Int
  owner       User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId     Int

  @@index([parentDirId]) // needed mainly for querying all nested dirs and files, but also helps in most operations.
}

model Session {
  id        String   @id
  sid       String   @unique
  data      String
  expiresAt DateTime
}
