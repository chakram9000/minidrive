// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int       @id @default(autoincrement())
  username  String    @unique @db.VarChar(64)
  password  String
  rootDir   Directory @relation(fields: [rootDirId], references: [id])
  rootDirId Int       @unique @map("root_dir_id")
}

model Directory {
  id          Int         @id @default(autoincrement())
  name        String
  files       File[]
  subDirs     Directory[] @relation("dir")
  parentDir   Directory?  @relation("dir", fields: [parentDirId], references: [id])
  parentDirId Int?
  owner       User?
}

model File {
  id          Int       @id @default(autoincrement())
  name        String
  systemPath  String    @unique @map("system_path")
  parentDir   Directory @relation(fields: [parentDirId], references: [id])
  parentDirId Int
}

model Session {
  id        String   @id
  sid       String   @unique
  data      String
  expiresAt DateTime
}
